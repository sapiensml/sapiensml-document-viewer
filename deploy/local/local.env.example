# Local settings for deploy/local/keycloak.sh and run-viewer.sh. Copied to local.env (git-ignored) on first use.
# KEY=value lines only; the same names as the server's /etc/sapiensml-document-viewer/viewer.env.

# Sign-in: the local Keycloak started by keycloak.sh
VIEWER_OIDC_ISSUER_URI=http://localhost:18210/realms/sapiensml
VIEWER_OIDC_CLIENT_ID=sapiensml-document-viewer
# Generated by keycloak.sh on first start
VIEWER_OIDC_CLIENT_SECRET=

# Alfresco: enter the connection once on the admin page (http://localhost:18200/admin, sign in as
# vieweradmin/vieweradmin). It is kept in .work/settings. Values set here are used only until then:
# Alfresco with repository users (Community or Enterprise), for example the SapiensML test repository:
#VIEWER_ALFRESCO_BASE_URL=https://alfresco.sapiensml.com
#VIEWER_ALFRESCO_AUTH=BASIC
#VIEWER_ALFRESCO_USERNAME=
#VIEWER_ALFRESCO_PASSWORD=
# Alfresco PaaS, or Alfresco with the Identity Service (OAuth2 client credentials):
#VIEWER_ALFRESCO_BASE_URL=https://<tenant>.alfrescocloud.com
#VIEWER_ALFRESCO_AUTH=CLIENT_CREDENTIALS
#VIEWER_ALFRESCO_TOKEN_URI=https://<tenant>.alfrescocloud.com/auth/realms/alfresco/protocol/openid-connect/token
#VIEWER_ALFRESCO_CLIENT_ID=
#VIEWER_ALFRESCO_CLIENT_SECRET=
# Folders whose documents may open (node IDs, comma separated):
#VIEWER_ALLOWED_FOLDER_IDS=<folder node id>,<folder node id>

VIEWER_ALLOW_DOWNLOAD=true
VIEWER_ALLOW_PRINT=true

VIEWER_PORT=18200
VIEWER_MANAGEMENT_PORT=18201
VIEWER_COOKIE_SECURE=false

# Local Keycloak (keycloak.sh): vendor-default admin login; test users viewer/viewer, vieweradmin/vieweradmin, noaccess/noaccess
KEYCLOAK_VERSION=26.8.2
KEYCLOAK_PORT=18210
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
