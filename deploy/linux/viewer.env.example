# /etc/sapiensml-document-viewer/viewer.env: settings of the SapiensML Document Viewer, read by systemd.
# Format: KEY=value, one per line, no quotes, no spaces around "=". Comments only on their own lines.
# After a change: sudo systemctl restart sapiensml-document-viewer
# install.sh refuses to start the service while any value is still CHANGE_ME.

# ---- Sign-in (OpenID Connect) ----------------------------------------------------------------------------------
# Keycloak: https://<keycloak host>/realms/<realm>. Okta: https://<org>.okta.com/oauth2/<authorization server id>
VIEWER_OIDC_ISSUER_URI=https://CHANGE_ME/realms/sapiensml
VIEWER_OIDC_CLIENT_ID=sapiensml-document-viewer
VIEWER_OIDC_CLIENT_SECRET=CHANGE_ME
VIEWER_OIDC_SCOPES=openid,profile,email
VIEWER_OIDC_USERNAME_CLAIM=preferred_username
# The claim with the user's roles or groups, and the values that may view documents (comma separated).
# Keycloak (realm in deploy/keycloak): roles / DOCUMENT_VIEWER. Okta: groups / <the Okta group names>
VIEWER_ROLES_CLAIM=roles
VIEWER_ROLES=DOCUMENT_VIEWER
# Keycloak brokering Okta: the identity provider alias, so users go straight to Okta
#VIEWER_OIDC_IDP_HINT=okta

# The claim values that may use the admin page (/admin), where the Alfresco connection is set up
VIEWER_ADMIN_ROLES=VIEWER_ADMIN

# ---- Alfresco ---------------------------------------------------------------------------------------------------
# Normally entered once on the admin page (https://<viewer>/admin) by a user with VIEWER_ADMIN_ROLES; it is kept in
# /var/lib/sapiensml-document-viewer with its secret encrypted by VIEWER_SETTINGS_KEY. Values set here are used only
# until something is saved there. All may stay empty.
# Alfresco with repository users (Community or Enterprise), for example the SapiensML test repository:
#VIEWER_ALFRESCO_BASE_URL=https://alfresco.sapiensml.com
#VIEWER_ALFRESCO_AUTH=BASIC
#VIEWER_ALFRESCO_USERNAME=
#VIEWER_ALFRESCO_PASSWORD=
# Alfresco PaaS, or Alfresco with the Identity Service (OAuth2 client credentials):
#VIEWER_ALFRESCO_BASE_URL=https://<tenant>.alfrescocloud.com
#VIEWER_ALFRESCO_AUTH=CLIENT_CREDENTIALS
#VIEWER_ALFRESCO_TOKEN_URI=https://<tenant>.alfrescocloud.com/auth/realms/alfresco/protocol/openid-connect/token
#VIEWER_ALFRESCO_CLIENT_ID=
#VIEWER_ALFRESCO_CLIENT_SECRET=
# Folders whose documents may open (node IDs, comma separated):
#VIEWER_ALLOWED_FOLDER_IDS=<folder node id>,<folder node id>
VIEWER_ALFRESCO_READ_TIMEOUT=60s
VIEWER_ALFRESCO_MAX_CONNECTIONS=100
# Content types that may be opened, for example ins:document. Empty: any type
VIEWER_ALLOWED_NODE_TYPES=
# Encrypts the secrets the admin page stores (base64 of 32 random bytes). install.sh generates it; keep a copy in
# the password manager: without it the saved connection must be entered again
VIEWER_SETTINGS_KEY=

# ---- Viewer -------------------------------------------------------------------------------------------------------
VIEWER_APP_NAME=SapiensML Document Viewer
VIEWER_ALLOW_DOWNLOAD=false
VIEWER_ALLOW_PRINT=true
# Origins that may show the viewer in a frame (space or comma separated). Empty: none
VIEWER_FRAME_ANCESTORS=
VIEWER_SESSION_TIMEOUT=30m

# ---- Server ---------------------------------------------------------------------------------------------------------
# nginx on the same host terminates TLS, so the viewer listens on loopback only
VIEWER_ADDRESS=127.0.0.1
VIEWER_PORT=8080
VIEWER_MANAGEMENT_PORT=8081
VIEWER_COOKIE_SECURE=true
VIEWER_AUDIT_DIR=/var/log/sapiensml-document-viewer
VIEWER_AUDIT_RETENTION_DAYS=400
VIEWER_LOG_LEVEL=INFO
# Outbound proxy to reach Alfresco: add -Dhttps.proxyHost=<host> -Dhttps.proxyPort=<port> -Dhttp.nonProxyHosts=localhost|127.0.0.1
# Corporate CA for TLS inspection: add -Djavax.net.ssl.trustStore=/etc/sapiensml-document-viewer/truststore.p12 -Djavax.net.ssl.trustStorePassword=<pw>
JAVA_OPTS=-Xms256m -Xmx768m -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom
# Java 21 or newer; install.sh uses the java on the PATH unless this is set
#JAVA_BIN=/usr/lib/jvm/java-21-openjdk/bin/java
