{
  "realm": "sapiensml",
  "displayName": "SapiensML",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "DOCUMENT_VIEWER",
        "description": "May open documents in the SapiensML Document Viewer"
      },
      {
        "name": "VIEWER_ADMIN",
        "description": "May set up the SapiensML Document Viewer's Alfresco connection (admin page)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sapiensml-document-viewer",
      "name": "SapiensML Document Viewer",
      "description": "SapiensML Document Viewer: opens Alfresco documents from links in business applications (confidential client, authorization code + PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "@VIEWER_CLIENT_SECRET@",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "redirectUris": [@VIEWER_REDIRECT_URIS@],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "@VIEWER_POST_LOGOUT_URIS@",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
