# Shell scripts and systemd units run on Linux: always LF. PowerShell and batch files: CRLF on checkout.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.svg text
*.png binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
